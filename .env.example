# Copy to .env.local for local development. Never commit real values.

# Canonical public URL (used for metadata, sitemap and robots). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=

# Optional — Postgres connection string for storing contact-form messages.
# Without it the form validates input and offers to send the message by email instead.
DATABASE_URL=

# Optional — enables the floating portfolio assistant (Abacus.AI chat completions API).
# Without it the assistant is hidden.
ABACUSAI_API_KEY=
# Optional model override (default: gpt-5.4-mini)
ABACUSAI_MODEL=
